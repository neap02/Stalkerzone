<Defs>

  <!-- Файл сгенерирован Source/Tools/gen_packs.py.
       Рюкзаки и баллоны Зоны. Свой слой "спина": совместимы с любым костюмом, детектором и шлемом,
       но рюкзак/баллон можно надеть только один. Грузоподъёмность — стат SZ_InventoryCapacity
       (инвентарь и караваны, C#: ZoneHarmony). -->

  <ApparelLayerDef>
    <defName>SZ_BackLayer</defName>
    <label>back</label>
    <drawOrder>3</drawOrder>
  </ApparelLayerDef>

  <StatDef>
    <defName>SZ_ArtifactShielding</defName>
    <label>artifact shielding</label>
    <description>How many active artifacts have their radiation blocked by the gear, in addition to lead containers in the inventory.</description>
    <category>PawnCombat</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>Integer</toStringStyle>
  </StatDef>

  <ThingDef ParentName="ApparelBase" Name="SZ_PackBase" Abstract="True">
    <techLevel>Industrial</techLevel>
    <tradeability>All</tradeability>
    <thingCategories Inherit="False"><li>ApparelUtility</li></thingCategories>
    <apparel>
      <layers><li>SZ_BackLayer</li></layers>
      <bodyPartGroups><li>Torso</li></bodyPartGroups>
      <careIfWornByCorpse>false</careIfWornByCorpse>
    </apparel>
  </ThingDef>

  <ThingDef ParentName="SZ_PackBase">
    <defName>SZ_Pack_Bag</defName>
    <label>canvas sack</label>
    <description>A simple canvas sack on a single strap. Holds a little, weighs nothing.</description>
    <graphicData>
      <texPath>Things/Item/SZ_Packs/Bag</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(0.45, 0.42, 0.30)</color>
      <colorTwo>(0.30, 0.27, 0.18)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <MarketValue>60</MarketValue>
      <Mass>0.8</Mass>
      <WorkToMake>1500</WorkToMake>
      <EquipDelay>2</EquipDelay>
      <Flammability>0.5</Flammability>
    </statBases>
    <equippedStatOffsets>
      <SZ_InventoryCapacity>20</SZ_InventoryCapacity>
    </equippedStatOffsets>
    <apparel>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/SZ_Packs/Bag/Bag</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <tags><li>SZ_Faction_Loners</li><li>SZ_Faction_Bandits</li></tags>
    </apparel>
    <costList><Cloth>30</Cloth></costList>
    <recipeMaker>
      <researchPrerequisite>ComplexClothing</researchPrerequisite>
      <recipeUsers><li>HandTailoringBench</li><li>ElectricTailoringBench</li></recipeUsers>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <skillRequirements><Crafting>2</Crafting></skillRequirements>
    </recipeMaker>
  </ThingDef>

