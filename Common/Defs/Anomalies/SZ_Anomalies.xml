<Defs>
  <!-- Файл сгенерирован Source/Tools/gen_zone.py из одной таблицы.
       Аномалии по мотивам Зоны: названия узнаваемые, описания, баланс, текстуры и звуки свои. -->

  <!-- ================= УРОН АНОМАЛИЙ =================
       По одному DamageDef на тип аномалии. defaultDamage и defaultArmorPenetration —
       характеристики удара; armorCategory — какая защита от него спасает (SZ_Protection.xml). -->
  <DamageDef Name="SZ_AnomalyDamageBase" Abstract="True">
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <combatLogRules>Damage_Bomb</combatLogRules>
  </DamageDef>

  <DamageDef ParentName="SZ_AnomalyDamageBase">
    <defName>SZ_GravityCrushLight</defName>
    <label>gravitational blow</label>
    <deathMessage>{0} was killed by a gravitational anomaly.</deathMessage>
    <hediff>Crush</hediff>
    <armorCategory>SZ_Strike</armorCategory>       <!-- категория защиты -->
    <defaultDamage>12</defaultDamage>
    <defaultArmorPenetration>0.15</defaultArmorPenetration>
  </DamageDef>

  <DamageDef ParentName="SZ_AnomalyDamageBase">
    <defName>SZ_GravityCrushHeavy</defName>
    <label>gravitational collapse</label>
    <deathMessage>{0} was crushed by a gravitational collapse.</deathMessage>
    <hediff>Crush</hediff>
    <armorCategory>SZ_Strike</armorCategory>       <!-- категория защиты -->
    <defaultDamage>35</defaultDamage>
    <defaultArmorPenetration>0.35</defaultArmorPenetration>
  </DamageDef>

  <DamageDef ParentName="SZ_AnomalyDamageBase">
