  <!-- ================= ТИПЫ АНОМАЛИЙ =================
       StalkerZone.AnomalyDef — не вещь, а описание явления (C#: AnomalyDef.cs).
       Аномалии на карте — записи MapComponent_Zone: их нельзя выбрать, атаковать,
       перенести, купить или заспавнить как предмет. Рисует их сама Зона,
       при наведении курсора показывается подсказка с описанием и уроном.
       artifacts: какие артефакты прячутся рядом (weight — частота, tier — какой детектор найдёт). -->

  <!-- Трамплин: гравитационная: слабый удар, маленький радиус -->
  <StalkerZone.AnomalyDef>
    <defName>SZ_Anomaly_Springboard</defName>
    <label>springboard</label>
    <description>A patch of air where dust hangs strangely still. Whatever steps into it is slammed by a short burst of gravity. Damage: 12 (strike), armor penetration 15%. Artifacts are sometimes found in or near it.</description>
    <texPath>Things/Building/SZ_Anomalies/Springboard</texPath>
    <drawSize>1.6</drawSize>
    <glowColor>(0.63, 0.43, 1.00, 0.45)</glowColor>
    <glowSize>2.9</glowSize>
    <damage>SZ_GravityCrushLight</damage>
    <per10k>0.275</per10k>
    <nearRadius>4</nearRadius>
    <nearHediff>SZ_Near_Gravity</nearHediff>
    <triggerRadius>1.5</triggerRadius>
    <cooldownTicks>180</cooldownTicks>
    <effectRadius>1.5</effectRadius>
    <throwsInsteadOfDamage>true</throwsInsteadOfDamage>
    <throwDistance>5</throwDistance>
    <stunTicks>90</stunTicks>
    <avoidRadius>2.5</avoidRadius>
    <fx>Gravity</fx>
    <sound>SZ_Gravity_Discharge</sound>
    <idleSound>SZ_Gravity_Idle</idleSound>
    <fleck>Dust</fleck>
    <fps>8</fps>
    <artifacts>
      <li><artifact>SZ_Artifact_Jellyfish</artifact><weight>0.185</weight><tier>1</tier></li>   <!-- медуза, обычный -->
      <li><artifact>SZ_Artifact_StoneFlower</artifact><weight>0.09</weight><tier>2</tier></li>   <!-- каменный цветок, необычный -->
    </artifacts>
  </StalkerZone.AnomalyDef>

  <!-- Воронка: гравитационная: сильный урон, большой радиус -->
  <StalkerZone.AnomalyDef>
    <defName>SZ_Anomaly_Vortex</defName>
    <label>vortex</label>
    <description>A wide swirl of leaves and debris circling a single point. It drags in anything within about five cells and crushes it at the center. A creature moving away can break free, especially right after a discharge. Damage: 35 (strike), armor penetration 35%. Artifacts are sometimes found in or near it.</description>
    <texPath>Things/Building/SZ_Anomalies/Vortex</texPath>
    <drawSize>2.2</drawSize>
    <glowColor>(0.59, 0.47, 0.86, 0.45)</glowColor>
    <glowSize>4.0</glowSize>
    <damage>SZ_GravityCrushHeavy</damage>
    <per10k>0.275</per10k>
    <nearRadius>7</nearRadius>
    <nearHediff>SZ_Near_Gravity</nearHediff>
    <triggerRadius>1.5</triggerRadius>
    <cooldownTicks>600</cooldownTicks>
    <effectRadius>1.9</effectRadius>
    <pullRadius>4.9</pullRadius>
    <pullInterval>60</pullInterval>
    <pullStrength>0.8</pullStrength>
    <avoidRadius>5.5</avoidRadius>
    <fx>Gravity</fx>
    <sound>SZ_Gravity_Discharge</sound>
    <idleSound>SZ_Gravity_Idle</idleSound>
    <fleck>Dust</fleck>
    <clusterMin>2</clusterMin>
    <clusterMax>3</clusterMax>
    <memberSpacing>7</memberSpacing>
    <artifactChance>0.5</artifactChance>
    <fps>8</fps>
    <artifacts>
      <li><artifact>SZ_Artifact_Gravi</artifact><weight>0.185</weight><tier>1</tier></li>   <!-- грави, обычный -->
      <li><artifact>SZ_Artifact_NightStar</artifact><weight>0.09</weight><tier>2</tier></li>   <!-- ночная звезда, необычный -->
    </artifacts>
  </StalkerZone.AnomalyDef>

