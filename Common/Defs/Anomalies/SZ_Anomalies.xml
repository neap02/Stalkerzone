  <ThingDef ParentName="SZ_AnomalyBase" Name="SZ_AnomalyType_Springboard" Abstract="True">
    <label>springboard</label>
    <description>A patch of air where dust hangs strangely still. Whatever steps into it is slammed by a short burst of gravity. Destroying it from a distance may leave behind an artifact.</description>
    <graphicData>
      <texPath>Things/Building/SZ_Anomalies/Springboard</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>  <!-- мягкое свечение с прозрачностью -->
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <comps>
      <li Class="CompProperties_Explosive">
        <explosiveRadius>1.5</explosiveRadius>
        <explosiveDamageType>SZ_GravityCrushLight</explosiveDamageType>
        <startWickHitPointsPercent>0.5</startWickHitPointsPercent>
        <wickTicks>10~20</wickTicks>         <!-- почти мгновенный разряд -->
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3.5</glowRadius>
        <glowColor>(160,110,255,0)</glowColor>
      </li>
    </comps>
  </ThingDef>
