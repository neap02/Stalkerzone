  <!-- Звуки Зоны. Все записи синтезированы генератором Source/Tools/gen_sounds.py.
       AudioGrain_Folder: из папки берётся случайный файл, плюс разброс высоты тона. -->

  <!-- разряд электры -->
  <SoundDef>
    <defName>SZ_Electro_Discharge</defName>
    <context>MapOnly</context>
    <maxSimultaneous>4</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>SZ/Electro/Discharge</clipFolderPath>
          </li>
        </grains>
        <volumeRange>45~55</volumeRange>
        <pitchRange>0.92~1.08</pitchRange>
        <distRange>10~60</distRange>
      </li>
    </subSounds>
  </SoundDef>

