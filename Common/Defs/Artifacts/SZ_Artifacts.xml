<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Файл сгенерирован Source/Tools/gen_zone.py. -->

  <ThingCategoryDef>
    <defName>SZ_Artifacts</defName>
    <label>artifacts</label>
    <parent>Manufactured</parent>
  </ThingCategoryDef>

  <!-- ================= БАЗА АРТЕФАКТА: ПРЕДМЕТ =================
       Не одежда: артефакт кладут в пояс (инвентарь пешки). C#-часть
       (MapComponent_Zone) включает эффекты первых N артефактов и облучение. -->
  <ThingDef Name="SZ_ArtifactBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Item</altitudeLayer>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <useHitPoints>true</useHitPoints>
    <stackLimit>1</stackLimit>
    <tradeability>All</tradeability>
    <techLevel>Ultra</techLevel>
    <thingCategories>
      <li>SZ_Artifacts</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <Beauty>5</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
    <thingSetMakerTags>
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
  </ThingDef>

  <!-- ============ Из аномалии «трамплин» ============ -->
  <HediffDef>
    <defName>SZ_ArtifactEffect_Jellyfish</defName>
    <label>artifact: jellyfish</label>
    <description>Effect of the artifact carried in the belt. Several identical artifacts add up.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.85, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>5</maxSeverity>
    <stages>
      <li><label>x1</label><statOffsets><CarryingCapacity>25</CarryingCapacity></statOffsets></li>
      <li><label>x2</label><minSeverity>1.5</minSeverity><statOffsets><CarryingCapacity>50</CarryingCapacity></statOffsets></li>
      <li><label>x3</label><minSeverity>2.5</minSeverity><statOffsets><CarryingCapacity>75</CarryingCapacity></statOffsets></li>
      <li><label>x4</label><minSeverity>3.5</minSeverity><statOffsets><CarryingCapacity>100</CarryingCapacity></statOffsets></li>
      <li><label>x5</label><minSeverity>4.5</minSeverity><statOffsets><CarryingCapacity>125</CarryingCapacity></statOffsets></li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="SZ_ArtifactBase">   <!-- медуза, обычный -->
    <defName>SZ_Artifact_Jellyfish</defName>
    <label>jellyfish</label>
    <description>A translucent, gently pulsing mass that is lighter than it looks. Loads feel lighter to its wearer. Emits weak radiation. Works when carried in the artifact belt (inventory); the number of belt slots depends on the suit. A lead container in the inventory blocks its radiation.</description>
    <graphicData>
      <texPath>Things/Item/SZ_Artifacts/Jellyfish</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>500</MarketValue>
      <Mass>0.5</Mass>
    </statBases>
    <modExtensions>
      <li Class="StalkerZone.ArtifactExtension">
        <effectHediff>SZ_ArtifactEffect_Jellyfish</effectHediff>
        <radiationPerDay>0.08</radiationPerDay>   <!-- лучевая болезнь в сутки, пока на поясе -->
      </li>
    </modExtensions>
  </ThingDef>

