<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Мрачные погоды Зоны во всех биомах (веса относительно ванильных, например Clear ~18) -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/BiomeDef/weatherCommonalities</xpath>
    <value>
      <SZ_Weather_Overcast>8</SZ_Weather_Overcast>
      <SZ_Weather_Drizzle>4</SZ_Weather_Drizzle>
      <SZ_Weather_ZoneFog>3</SZ_Weather_ZoneFog>
    </value>
  </Operation>
</Patch>
