<Project Sdk="Microsoft.NET.Sdk">

  <!-- ===== Путь к DLL игры 1.7 (ветка unstable) =====
       В 1.7 файлы Assembly-CSharp.dll, UnityStubs.dll и Waylith.dll лежат в корне папки игры.
       Совет: скопируйте эти три файла, например, в Source/Refs/1.7 и укажите этот путь.
       Тогда сборка под 1.7 не сломается, когда Steam вернёт игру на ветку 1.6. -->
  <PropertyGroup>
    <RimWorld17Refs>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorld17Refs>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 1.6 собирается всегда. 1.7 добавляется, только если найдены DLL игры 1.7 -->
    <TargetFrameworks>net472</TargetFrameworks>
    <TargetFrameworks Condition="Exists('$(RimWorld17Refs)\Waylith.dll')">net472;net10.0</TargetFrameworks>

    <AssemblyName>StalkerZone</AssemblyName>
    <RootNamespace>StalkerZone</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>

    <!-- Класть DLL прямо в Assemblies, без подпапок net472 / net10.0 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Не создавать .deps.json: игра его всё равно игнорирует -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <!-- Куда класть DLL для каждой версии игры -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
  </PropertyGroup>

  <!-- 1.6: референсы игры из NuGet. Установленная 1.6 для сборки не нужна -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
  </ItemGroup>

  <!-- 1.7: референсы из папки игры.
       Private=false: НЕ копировать эти DLL в Assemblies мода, иначе игра сломается -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorld17Refs)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorld17Refs)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorld17Refs)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
