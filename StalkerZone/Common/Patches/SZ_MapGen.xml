<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Добавляем аномалии в генерацию карты колонии (Base_Player).
       PatchOperationConditional: если такого узла нет, патч молча пропускается.
       Работает только для НОВЫХ карт. На текущую ставьте через режим разработчика. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/MapGeneratorDef[defName="Base_Player"]/genSteps</xpath>
      <value>
        <li>SZ_Scatter_Springboard_Jellyfish</li>
        <li>SZ_Scatter_Springboard_StoneFlower</li>
        <li>SZ_Scatter_Vortex_Gravi</li>
        <li>SZ_Scatter_Vortex_NightStar</li>
        <li>SZ_Scatter_Whirligig_MamasBeads</li>
        <li>SZ_Scatter_Whirligig_Goldfish</li>
        <li>SZ_Scatter_Meatgrinder_MeatChunk</li>
        <li>SZ_Scatter_Meatgrinder_Soul</li>
        <li>SZ_Scatter_Electro_Flash</li>
        <li>SZ_Scatter_Electro_Sparkler</li>
        <li>SZ_Scatter_Electro_Battery</li>
        <li>SZ_Scatter_Electro_Moonlight</li>
        <li>SZ_Scatter_Burner_Droplet</li>
        <li>SZ_Scatter_Burner_Fireball</li>
        <li>SZ_Scatter_Burner_Crystal</li>
        <li>SZ_Scatter_Comet_Flame</li>
        <li>SZ_Scatter_FruitPunch_Slime</li>
        <li>SZ_Scatter_FruitPunch_Slug</li>
        <li>SZ_Scatter_FruitPunch_StoneBlood</li>
        <li>SZ_Scatter_BurntFuzz_Thorn</li>
        <li>SZ_Scatter_BurntFuzz_Urchin</li>
      </value>
    </match>
  </Operation>

</Patch>
