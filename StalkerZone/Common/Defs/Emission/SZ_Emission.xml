<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ================= ПОГОДА ВЫБРОСА =================
       Красное небо, частые молнии, ветер.
       Не прописана в weatherCommonalities биомов, поэтому
       сама не выпадает: включается только через GameCondition ниже. -->
  <WeatherDef>
    <defName>SZ_EmissionWeather</defName>
    <label>emission</label>
    <description>The sky glows red and lightning strikes again and again.</description>
    <isBad>true</isBad>
    <favorability>VeryBad</favorability>
    <perceivePriority>2</perceivePriority>
    <windSpeedFactor>2.5</windSpeedFactor>
    <accuracyMultiplier>0.8</accuracyMultiplier>
    <eventMakers>
      <li>
        <averageInterval>600</averageInterval> <!-- вспышки, ~раз в 10 сек -->
        <eventClass>WeatherEvent_LightningFlash</eventClass>
      </li>
      <li>
        <averageInterval>1500</averageInterval> <!-- удары молний, могут поджигать -->
        <eventClass>WeatherEvent_LightningStrike</eventClass>
      </li>
    </eventMakers>
    <!-- Цвета неба: sky / shadow / overlay в RGB 0..1 -->
    <skyColorsDay>
      <sky>(0.85, 0.35, 0.25)</sky>
      <shadow>(0.5, 0.2, 0.15)</shadow>
      <overlay>(0.8, 0.4, 0.3)</overlay>
      <saturation>1.1</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.7, 0.2, 0.15)</sky>
      <shadow>(0.45, 0.15, 0.1)</shadow>
      <overlay>(0.6, 0.25, 0.2)</overlay>
      <saturation>1.1</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.45, 0.12, 0.1)</sky>
      <shadow>(0.3, 0.1, 0.08)</shadow>
      <overlay>(0.4, 0.15, 0.12)</overlay>
      <saturation>1</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.4, 0.1, 0.08)</sky>
      <shadow>(0.28, 0.08, 0.06)</shadow>
      <overlay>(0.35, 0.12, 0.1)</overlay>
      <saturation>1</saturation>
    </skyColorsNightMid>
  </WeatherDef>

  <!-- ================= МУДЛЕТ =================
       Тип по умолчанию: Thought_Memory. Выдаёт C#-часть (GameCondition_Emission)
       людям под открытым небом и обновляет, пока Выброс идёт. Без DLL не используется. -->
  <ThoughtDef>
    <defName>SZ_ExposedToEmission</defName>
    <durationDays>0.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>caught in the emission</label>
        <description>I was outside during the emission. I'm still shaking.</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ================= УСЛОВИЕ "ВЫБРОС" =================
       В XML стоит ванильный класс, поэтому мод грузится без ошибок везде.
       Если StalkerZone.dll загрузилась, она при старте игры сама заменит класс
       на GameCondition_Emission: час на укрытие (колонисты уходят под крышу сами),
       затем пик с пси-ударом и радиацией, в конце перестановка аномалий.
       См. GameCondition_Emission.cs.
       Баланс облучения задаётся константами в GameCondition_Emission.cs. -->
  <GameConditionDef>
    <defName>SZ_Emission</defName>
    <conditionClass>GameCondition_ForceWeather</conditionClass>
    <label>emission</label>
    <description>A wave of anomalous energy is sweeping through the region. Stay under a roof until it passes.</description>
    <endMessage>The emission has passed.</endMessage>
    <letterText>The sky is turning red: an emission is coming. Get everyone under a roof!</letterText>
    <weatherDef>SZ_EmissionWeather</weatherDef>
    <canBePermanent>false</canBePermanent>
    <pennedAnimalsSeekShelter>true</pennedAnimalsSeekShelter> <!-- животные из загонов уходят под крышу -->
  </GameConditionDef>

  <!-- ================= ИНЦИДЕНТ =================
       Рассказчик запускает условие SZ_Emission на карте колонии. -->
  <IncidentDef>
    <defName>SZ_Emission</defName>
    <label>emission</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>IncidentWorker_MakeGameCondition</workerClass>
    <gameCondition>SZ_Emission</gameCondition>
    <letterLabel>Emission</letterLabel>
    <letterDef>ThreatSmall</letterDef>
    <baseChance>1.0</baseChance>       <!-- относительный вес среди Misc-событий -->
    <earliestDay>5</earliestDay>       <!-- не раньше 5-го дня колонии -->
    <minRefireDays>8</minRefireDays>   <!-- не чаще раза в 8 дней -->
    <durationDays>0.1~0.15</durationDays> <!-- 2.4–3.6 ч: 1 ч приближения + пик (с C#) -->
  </IncidentDef>

</Defs>
